# Configuración del Servidor Punto de Venta (POS)
PORT=4000
NODE_ENV=production

# Seguridad y PIN de Supervisor por defecto
SUPERVISOR_PIN=1234

# Ruta de Base de Datos SQLite (opcional, por defecto pos.db en la raíz)
# POS_DB_PATH=./pos.db

# Impresoras Térmicas ESC/POS (80mm) por Red TCP (Puerto 9100)
PRINTER_CAJA_IP=192.168.1.30
PRINTER_CAJA_PORT=9100
PRINTER_COCINA_IP=192.168.1.30
PRINTER_COCINA_PORT=9100
PRINTER_BARRA_IP=192.168.1.30
PRINTER_BARRA_PORT=9100

